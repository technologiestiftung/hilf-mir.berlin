NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-api-key  # make sure to restrict this API key to the domains you're deploying to (it's visible to the public)
NEXT_PUBLIC_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/bright/style.json
NEXT_SECRET_BASIC_AUTH_USER=foo
NEXT_SECRET_BASIC_AUTH_PASSWORD=one-secret-password
NEXT_PUBLIC_MATOMO_SITE_ID="0" # only required in production setup
NEXT_PUBLIC_MATOMO_URL="https://matomo.example.de" # only required in production setup